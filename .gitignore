# ── Malik Usman Farms monorepo ignores ─────────────────────────
# node_modules and generated build output stay OFF git. Local builds are
# reproducible from package-lock.json files; deployment build commands create
# each frontend dist/ folder before its backend serves the production app.
node_modules/
**/dist/
*.log

# Local reports generated by audit-muf-design-system.mjs.
.audit-output/

# Sandbox artifacts — must never be tracked in this repo.
# skills/ is the agent sandbox's installed skills directory.
# tool-results/ is a temp folder where oversized tool outputs land.
skills/
tool-results/

# Local env files (each app keeps its own .env; .env.example is tracked)
**/.env

# Playwright generated output. Approved PNG baselines under e2e/visual-baselines are tracked.
playwright-report/
test-results/
