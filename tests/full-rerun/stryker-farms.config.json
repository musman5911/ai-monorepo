{
  "mutate": [
    "dairy_farm/backend/muf-farms.mjs"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "tests/full-rerun/vitest-farm-mutation.config.mjs"
  },
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "results/full-rerun/mutation-farm-guards.json"
  },
  "concurrency": 2,
  "timeoutMS": 5000,
  "tempDirName": ".stryker-tmp-farms-rerun",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "ignorePatterns": [
    "results",
    "tools-round3",
    "**/dist",
    "**/.cache"
  ]
}
