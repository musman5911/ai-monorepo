modules = ["nodejs-20", "web"]
run = "npm --prefix backend install && npm --prefix client install --include=dev && npm --prefix client run build && cd backend && NODE_ENV=production npm start"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd client && npm install --include=dev && npm run build"]
run = ["sh", "-c", "cd backend && npm install && NODE_ENV=production npm start"]

[nix]
channel = "stable-25_05"
