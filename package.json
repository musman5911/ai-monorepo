{
  "name": "dairy-flock-agri-monorepo",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check-sync": "node tools/check-muf-sync.js",
    "check-ui": "node tools/check-ui-safety.js",
    "check-workbench": "node tools/check-muf-workbench.js",
    "check-workbench-runtime": "node tools/check-muf-workbench-runtime.js",
    "check-farms": "node tools/check-farm-scope.js && node tools/check-dairy-breeding-events.js",
    "check-breeding-events": "node tools/check-dairy-breeding-events.js",
    "check-super-admin": "node tools/check-super-admin.js",
    "check-docs": "node tools/check-phase-docs.js && node tools/check-guide-commands.js",
    "check-bundle-size": "node tools/check-bundle-size.js",
    "check-archive": "node tools/check-dairy-archive.js && node tools/check-flock-archive.js && node tools/check-agri-archive.js",
    "check-audit": "node tools/check-audit.js",
    "check-secrets": "node tools/check-secrets.js",
    "check-route-permissions": "node tools/check-route-permissions.js",
    "check-route-matrix": "node tools/check-route-matrix.js",
    "check-shop": "vitest run tests/shop-isolation.test.ts"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
