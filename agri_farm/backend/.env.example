# ═══════════════════════════════════════════════════════════════════════════
# Usman Agri Farm — backend environment
# Same env system across all three farms: dairy / flock / agri.
# Canonical names below; every legacy alias still works (muf-env.mjs).
# Copy to .env and fill in. Values may differ per app; NAMES are shared.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
# Real MongoDB (Atlas or local). If set, it ALWAYS wins.
# (Legacy alias MONGODB_URI still works.)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/farm_management

# Demo mode: leave MONGO_URI unset and set MEMORY_MODE=1 to run with an
# in-memory database seeded with a year of demo data (lost on restart).
# Logins: admin / admin123  |  worker / worker123
# MEMORY_MODE=1

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE-A-LONG-RANDOM-STRING-HERE
# (Legacy aliases SECRET_KEY / SESSION_SECRET still work.)
# Token lifetime accepts 1440m (24 hours) or 7d; bare integers mean minutes.
# JWT_EXPIRES_IN=1440m
# Cookie hardening behind HTTPS proxies:
# COOKIE_SECURE=1

# ── Server ──────────────────────────────────────────────────────────────────
# NODE_ENV=production is set by the Replit deployment run command.
PORT=8000
# Public app URL (email links, logo, Telegram webhook) — your own host
# APP_URL=https://your-app.example.com
# Frontend origin for CORS in production — comma-separated, several allowed
# (legacy alias CORS_ORIGIN still works)
# FRONTEND_URL=https://your-app.example.com

# ── Email (optional — password reset / profile codes / reports) ─────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com
# Legacy aliases (SMTP_SENDER / MAIL_FROM / EMAIL_HOST / EMAIL_PORT /
# EMAIL_USER / EMAIL_PASS) still work.

# ── Telegram bot (optional) ─────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# TELEGRAM_WEBHOOK_SECRET=long-random-string

# ── Cron (optional — cron-job.org pings /cron/dispatch-report and /telegram/cron) ────────────────────
# CRON_SECRET=long-random-string
# Internal in-process scheduler (on by default; disable when using an external pinger)
# DISABLE_INTERNAL_SCHEDULER=1

# ── Cross-farm "My Farms" summary (shared across the three apps) ────────────
# Use the SAME key in all three .env files:
# CROSS_FARM_KEY=long-random-string

# ── Cloudinary photo storage (optional; MongoDB remains the fallback) ──
# Set all three values in deployment secrets; never commit real credentials.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── Diagnostics ─────────────────────────────────────────────────────────────
# LOG_REQUESTS=1            # request auth logging for debugging
# TZ_OFFSET_HOURS=5         # farm timezone offset from UTC (Pakistan = 5)
